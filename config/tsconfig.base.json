{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "@tsconfig/node22/tsconfig.json",
	"compilerOptions": {
		// This is enforced in lint instead.
		"noUnusedLocals": false,
		"declaration": true,
		"declarationMap": true,
		"inlineSources": true,
		"sourceMap": true,
		"jsx": "react",
		"composite": true,
		"incremental": true,
	},
}

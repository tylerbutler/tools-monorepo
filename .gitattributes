# Set the language for these files to json5 to ensure GitHub doesn't show the comments as errors
**/.vscode/*.json              linguist-language=JSON-with-Comments
api-extractor*.json            linguist-language=JSON-with-Comments
nx.json                        linguist-language=JSON-with-Comments
tsconfig*.json                 linguist-language=JSON-with-Comments

*     text !filter !merge !diff
*     text=auto eol=lf
*.txt text=auto !eol

*.png -text
*.jpg -text
*.gif -text
*.pdf -text

# Hide docs from GitHub's language detection
**/api-docs/**                     linguist-documentation
**/docs/**                     linguist-documentation

# Treat Claude and Copilot support files as vendored
.agents/**                     linguist-vendored
.claude/**                     linguist-vendored
.copilot/**                    linguist-vendored
**/AGENTS.md                   linguist-vendored
**/CLAUDE.md                   linguist-vendored
.github/copilot-instructions.md linguist-vendored
.github/hooks/**               linguist-vendored
.github/instructions/**        linguist-vendored
.github/prompts/**             linguist-vendored

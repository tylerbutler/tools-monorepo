{
	"extends": "../../config/tsconfig.strict.json",
	"include": [
		"src/**/*"
	],
	"references": [
		{
			"path": "../cli-api"
		}
	],
	"compilerOptions": {
		"noPropertyAccessFromIndexSignature": false,
		// TODO: Should these settings be disabled in the strict config?
		"noUncheckedIndexedAccess": false,
		// "lib": ["ES2020", "DOM", "DOM.Iterable"],
		"types": [
			"node"
		],
		"outDir": "./esm",
		"rootDir": "./src"
	},
	"ts-node": {
		"esm": true
	}
}
{
	"name": "remark-sentence-per-line",
	"version": "0.1.0",
	"description": "Source-preserving Markdown formatter that puts each sentence on its own line",
	"homepage": "https://github.com/tylerbutler/tools-monorepo/tree/main/packages/remark-sentence-per-line#remark-sentence-per-line",
	"bugs": "https://github.com/tylerbutler/tools-monorepo/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tylerbutler/tools-monorepo.git",
		"directory": "packages/remark-sentence-per-line"
	},
	"license": "MIT",
	"author": "Tyler Butler <tyler@tylerbutler.com>",
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./esm/index.d.ts",
				"default": "./esm/index.js"
			}
		},
		"./format": {
			"import": {
				"types": "./esm/format.d.ts",
				"default": "./esm/format.js"
			}
		}
	},
	"types": "./esm/index.d.ts",
	"files": [
		"esm"
	],
	"scripts": {
		"build:compile": "tsc --project ./tsconfig.json",
		"clean": "rimraf esm _temp *.tsbuildinfo *.done.build.log",
		"release:license": "generate-license-file -c ../../.generatelicensefile.cjs",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"micromark-util-decode-string": "^2.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"sentence-splitter": "^5.0.1",
		"unified": "^11.0.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.5",
		"remark": "^15.0.1",
		"remark-stringify": "^11.0.0",
		"rimraf": "^6.1.3",
		"typescript": "~7.0.2",
		"vitest": "^5.0.5"
	},
	"engines": {
		"node": ">=22.22.0"
	},
	"nx": {
		"targets": {
			"build": {
				"executor": "nx:noop"
			},
			"test": {
				"executor": "nx:noop"
			},
			"ci": {}
		}
	}
}

{
	"extends": "../../config/tsconfig.strict.json",
	"include": ["src/**/*"],
	"references": [
		{
			"path": "../cli-api",
		},
		{
			"path": "../fundamentals",
		},
		{
			"path": "../lilconfig-loader-ts",
		},
	],
	"compilerOptions": {
		"noPropertyAccessFromIndexSignature": false,
		// TODO: Should these settings be disabled in the strict config?
		"noUncheckedIndexedAccess": true,
		"outDir": "esm",
		"rootDir": "src",
	},
	"ts-node": {
		"esm": true,
	},
}

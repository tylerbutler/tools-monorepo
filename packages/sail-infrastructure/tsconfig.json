{
	"extends": "../../config/tsconfig.strict.json",
	"include": [
		"src/**/*"
	],
	"exclude": [
		"src/test/**/*"
	],
	"references": [
		{
			"path": "../fundamentals"
		},
		{
			"path": "../lilconfig-loader-ts"
		}
	],
	"compilerOptions": {
		"exactOptionalPropertyTypes": false,
		"noUnusedLocals": false,
		"types": [
			"node"
		],
		"outDir": "./esm",
		"rootDir": "./src"
	}
}
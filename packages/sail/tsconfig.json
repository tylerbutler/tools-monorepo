{
	"extends": "../../config/tsconfig.strict.json",
	"include": [
		"src/**/*"
	],
	"exclude": [
		"src/test/**/*"
	],
	"references": [
		{
			"path": "../cli-api"
		},
		{
			"path": "../lilconfig-loader-ts"
		},
		{
			"path": "../sail-infrastructure"
		}
	],
	"compilerOptions": {
		"exactOptionalPropertyTypes": false,
		"noPropertyAccessFromIndexSignature": false,
		"noUncheckedIndexedAccess": false,
		"outDir": "./esm",
		"rootDir": "./src"
	},
	"ts-node": {
		"esm": true
	}
}